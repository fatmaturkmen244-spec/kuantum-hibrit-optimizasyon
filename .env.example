AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Azure Quantum (yalnızca buluta iş göndermek isterseniz gerekir)
AZURE_QUANTUM_RESOURCE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.Quantum/Workspaces/...
AZURE_QUANTUM_TARGET=

# Azure Maps (yalnızca backend/proxy ortamında tutun; docs/ veya tarayıcıya koymayın)
AZURE_MAPS_SUBSCRIPTION_KEY=
AZURE_MAPS_ENDPOINT=https://atlas.microsoft.com

# Herkese açık backend dağıtımında izin verilen ek web kökenleri (virgülle ayırın)
CORS_ALLOW_ORIGINS=
MAPS_RATE_LIMIT_PER_MINUTE=30

# Eski yerel ayar formu yalnız kendi bilgisayarınızda gerekliyse açıkça etkinleştirin.
# Public backend dağıtımında false kalmalıdır.
ENABLE_LOCAL_CONFIG=false
